<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Keep the server token out of backups and device transfers. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="server.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="server.xml" />
    </device-transfer>
</data-extraction-rules>
