# Copy to .env and fill in. Generate a token with:  openssl rand -hex 32
API_TOKEN=

# Host port the web UI / API is published on.
PORT=8000

# Parallel conversions, max file size (MB), and how long results are kept (h).
MAX_CONCURRENT_JOBS=2
MAX_FILE_MB=4096
JOB_TTL_HOURS=6

# Update yt-dlp on every container start (1 = yes).
YTDLP_AUTO_UPDATE=1
