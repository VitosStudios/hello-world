{
  "version": 1,
  "about": "AI provider presets. The user brings their own API key (stored in secure storage under 'apiKey.<id>'). protocol 'anthropic' = Claude Messages API, 'openai' = OpenAI-compatible Chat Completions. See shared/SPEC.md section 6 for the exact request rules.",
  "providers": [
    {
      "id": "anthropic",
      "name": "Claude (Anthropic)",
      "protocol": "anthropic",
      "baseUrl": "https://api.anthropic.com/v1",
      "defaultModel": "claude-opus-5-5",
      "models": [
        {
          "id": "claude-opus-5-5",
          "label": "Claude Opus 5.5 – beste Qualität"
        },
        {
          "id": "claude-sonnet-5-5",
          "label": "Claude Sonnet 5.5 – ausgewogen"
        },
        {
          "id": "claude-haiku-5-5",
          "label": "Claude Haiku 5.5 – am schnellsten & günstigsten"
        }
      ],
      "keyUrl": "https://console.anthropic.com/settings/keys",
      "keyHint": "sk-ant-…",
      "keyRequired": true,
      "jsonMode": false
    },
    {
      "id": "openai",
      "name": "ChatGPT (OpenAI)",
      "protocol": "openai",
      "baseUrl": "https://api.openai.com/v1",
      "defaultModel": "gpt-5-mini",
      "models": [
        {
          "id": "gpt-5-mini",
          "label": "GPT-5 mini – schnell"
        },
        {
          "id": "gpt-5-nano",
          "label": "GPT-5 nano – am günstigsten"
        },
        {
          "id": "gpt-5",
          "label": "GPT-5 – beste Qualität"
        }
      ],
      "keyUrl": "https://platform.openai.com/api-keys",
      "keyHint": "sk-…",
      "keyRequired": true,
      "jsonMode": true,
      "maxTokensField": "max_completion_tokens",
      "sendTemperature": false,
      "reasoningEffort": "low"
    },
    {
      "id": "gemini",
      "name": "Gemini (Google)",
      "protocol": "openai",
      "baseUrl": "https://generativelanguage.googleapis.com/v1beta/openai",
      "defaultModel": "gemini-flash-lite-latest",
      "models": [
        {
          "id": "gemini-flash-lite-latest",
          "label": "Gemini Flash-Lite – am schnellsten"
        },
        {
          "id": "gemini-flash-latest",
          "label": "Gemini Flash – ausgewogen"
        }
      ],
      "keyUrl": "https://aistudio.google.com/apikey",
      "keyHint": "AIza…",
      "keyRequired": true,
      "jsonMode": true,
      "maxTokensField": "max_tokens",
      "sendTemperature": true
    },
    {
      "id": "github",
      "name": "Copilot / GitHub Models",
      "protocol": "openai",
      "baseUrl": "https://models.github.ai/inference",
      "defaultModel": "openai/gpt-4.1-mini",
      "models": [
        {
          "id": "openai/gpt-4.1-mini",
          "label": "GPT-4.1 mini (via GitHub)"
        },
        {
          "id": "openai/gpt-4.1",
          "label": "GPT-4.1 (via GitHub)"
        },
        {
          "id": "openai/gpt-5-mini",
          "label": "GPT-5 mini (via GitHub)"
        }
      ],
      "keyUrl": "https://github.com/settings/personal-access-tokens",
      "keyHint": "GitHub-Token (fine-grained) mit Berechtigung „Models: read“",
      "keyRequired": true,
      "jsonMode": true,
      "maxTokensField": "max_tokens",
      "sendTemperature": true,
      "extraHeaders": {
        "Accept": "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28"
      }
    },
    {
      "id": "mistral",
      "name": "Mistral (EU)",
      "protocol": "openai",
      "baseUrl": "https://api.mistral.ai/v1",
      "defaultModel": "mistral-small-latest",
      "models": [
        {
          "id": "mistral-small-latest",
          "label": "Mistral Small – schnell"
        },
        {
          "id": "mistral-medium-latest",
          "label": "Mistral Medium"
        },
        {
          "id": "mistral-large-latest",
          "label": "Mistral Large – beste Qualität"
        }
      ],
      "keyUrl": "https://console.mistral.ai/api-keys",
      "keyHint": "Mistral API-Key",
      "keyRequired": true,
      "jsonMode": true,
      "maxTokensField": "max_tokens",
      "sendTemperature": true
    },
    {
      "id": "custom",
      "name": "Eigener Server / lokal (OpenAI-kompatibel)",
      "protocol": "openai",
      "baseUrl": "http://localhost:11434/v1",
      "baseUrlEditable": true,
      "defaultModel": "llama3.2",
      "models": [],
      "keyUrl": "",
      "keyHint": "optional",
      "keyRequired": false,
      "jsonMode": false,
      "maxTokensField": "max_tokens",
      "sendTemperature": true
    }
  ]
}
